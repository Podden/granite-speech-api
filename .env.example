# ===== App config =====
GRANITE_API_HOST=0.0.0.0
GRANITE_API_PORT=8000

# Default model loaded at startup. Auto-upgrades to ...-plus when the request
# asks for speaker_attribution or word-level timestamps.
GRANITE_DEFAULT_MODEL=ibm-granite/granite-speech-4.1-2b

# Device: "cuda", "cuda:0", "rocm" (mapped to cuda for torch+ROCm), "cpu", or "auto"
GRANITE_DEVICE=auto

# Torch dtype: "bfloat16" | "float16" | "float32"
GRANITE_DTYPE=bfloat16

# HuggingFace cache dir (optional)
# HF_HOME=/data/hf-cache
# HUGGING_FACE_HUB_TOKEN=

# Max audio duration (seconds) accepted per request
GRANITE_MAX_AUDIO_SECONDS=600

# Auto-unload the loaded model after N seconds of inactivity to free VRAM/RAM.
# Set to -1 to disable (model stays loaded forever).
GRANITE_IDLE_UNLOAD_SECONDS=600
GRANITE_IDLE_CHECK_INTERVAL=30

# Allowed origins for CORS, comma-separated. "*" to disable restriction.
GRANITE_CORS_ORIGINS=*
